{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-rename",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**/*.[bB][rR][nN]" },
        { "path": "**/*.[bB][rR][nN].tmp" },
        { "path": "**/*.[bB][rR][nN].[jJ][sS][oO][nN]" },
        { "path": "**/*.[bB][rR][nN].[jJ][sS][oO][nN].tmp" }
      ]
    }
  ]
}
