{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bornera",
  "version": "0.1.4-alpha.2",
  "identifier": "com.bornera.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Bornera",
        "width": 1024,
        "height": 600,
        "minWidth": 800,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["brn"],
        "name": "Bornera",
        "description": "Circuito de Bornera",
        "role": "Editor"
      }
    ],
    "windows": {
      "allowDowngrades": true,
      "wix": {
        "version": "0.1.4.2"
      }
    }
  }
}
