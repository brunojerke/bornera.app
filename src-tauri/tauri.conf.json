{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bornera",
  "version": "0.1.3-alpha.3",
  "identifier": "com.bornera.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Bornera",
        "width": 1024,
        "height": 600,
        "minWidth": 800,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.1.3.3"
      }
    }
  }
}
